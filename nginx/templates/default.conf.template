log_format vistay escape=json '{"time":"$time_iso8601","remote_addr":"$remote_addr",'
    '"request":"$request","status":$status,"bytes":$body_bytes_sent,'
    '"request_time":$request_time,"upstream_time":"$upstream_response_time",'
    '"request_id":"$request_id"}';

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

server {
    listen 8080 default_server;
    server_name _;
    access_log /dev/stdout vistay;
    location = /healthz { access_log off; return 200 'ok'; add_header Content-Type text/plain; }
    location / { return 404; }
}

server {
    listen 8080;
    server_name ${BACKOFFICE_GRAPHQL_HOST};
    access_log /dev/stdout vistay;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    server_tokens off;

    location = /_edge/ready {
        proxy_pass http://router-backoffice:4000/readiness;
        include /etc/nginx/proxy_params;
    }
    location ~ ^/graphql(?:/|$) {
        proxy_pass http://router-backoffice:4000;
        proxy_http_version 1.1;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
    location / { return 404; }
}

server {
    listen 8080;
    server_name ${KEYCLOAK_HOST};
    access_log /dev/stdout vistay;
    server_tokens off;
    location ~ ^/(realms/vistay-backoffice/|resources/) {
        proxy_pass http://keycloak:8080;
        include /etc/nginx/proxy_params;
    }
    location / { return 404; }
}

server {
    listen 8080;
    server_name ${BACKOFFICE_WEB_HOST};
    access_log /dev/stdout vistay;
    server_tokens off;
    location / {
        proxy_pass http://frontend-admin:8080;
        include /etc/nginx/proxy_params;
    }
}

server {
    listen 8080;
    server_name ${BACKOFFICE_AUTH_HOST};
    access_log /dev/stdout vistay;
    server_tokens off;
    location = /_edge/ready {
        proxy_pass http://authentication:8080/actuator/health/readiness;
        include /etc/nginx/proxy_params;
    }
    location = /api/v1/backoffice/accounts/bootstrap {
        proxy_pass http://authentication:8080;
        include /etc/nginx/proxy_params;
    }
    location / { return 404; }
}

server {
    listen 8080;
    server_name ${OBJECT_STORAGE_HOST};
    access_log /dev/stdout vistay;
    server_tokens off;
    location / {
        proxy_pass http://minio:9000;
        include /etc/nginx/proxy_params;
        proxy_request_buffering off;
    }
}

server {
    listen 8080;
    server_name ${CHANNEL_MANAGER_WEBHOOK_HOST};
    access_log /dev/stdout vistay;
    server_tokens off;
    location ^~ /webhooks/channel-manager {
        proxy_pass http://ota:8080;
        include /etc/nginx/proxy_params;
    }
    location / { return 404; }
}

server {
    listen 8080;
    server_name ${PAYMENT_WEBHOOK_HOST};
    access_log /dev/stdout vistay;
    server_tokens off;
    client_max_body_size 256k;
    location ^~ /webhooks/vietqr/ {
        proxy_pass http://payment:8080;
        include /etc/nginx/proxy_params;
        proxy_request_buffering off;
    }
    location / { return 404; }
}
