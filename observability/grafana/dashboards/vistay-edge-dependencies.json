    {
      "type": "table",
      "title": "All Prometheus targets",
      "datasource": { "type": "prometheus", "uid": "vistay-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        { "expr": "up", "format": "table", "instant": true, "refId": "A" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "type": "timeseries",
      "title": "Router request rate",
      "datasource": { "type": "prometheus", "uid": "vistay-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "targets": [
        { "expr": "sum by (router, http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"router-metrics\"}[5m]))", "legendFormat": "{{router}} HTTP {{http_response_status_code}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true }
