        "justifyMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Frontend probe duration",
      "datasource": { "type": "prometheus", "uid": "vistay-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "probe_duration_seconds{job=\"frontends\"}", "legendFormat": "{{frontend}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries",
      "title": "Router probe duration",
      "datasource": { "type": "prometheus", "uid": "vistay-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "probe_duration_seconds{job=\"routers\"}", "legendFormat": "{{router}}", "refId": "A" }
