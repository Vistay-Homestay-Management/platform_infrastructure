# Immutable runtime images. Upgrade only through a reviewed compatibility test.
HIVE_ROUTER_IMAGE=ghcr.io/graphql-hive/router:0.3.5@sha256:feaf52e70615f8516d86c4c07f6f29046d88e1b38f9cf6aa099d17b2b51f4827
HIVE_ROUTER_ROLLBACK_IMAGE=ghcr.io/graphql-hive/router:0.3.4@sha256:37d1c1b6b67bfd45b0034064e2e14d00b4467acdba043d17806f7f85242fa053
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1@sha256:79c623a22abacf3fe6c00a5fb30f5b7843d717b234033b80995891c06116d244
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.28.0-alpine@sha256:c97ff0bf7cbae369953c6da1232ec14ad9f971d66360c5698db0856a4cd657a0

# Local dependency credentials. Replace every value after copying this file.
POSTGRES_USER=vistay
POSTGRES_PASSWORD=change-local-postgres-password
AUTHENTICATION_DB_MIGRATOR_PASSWORD=change-local-authentication-migrator-password
AUTHENTICATION_DB_APP_PASSWORD=change-local-authentication-app-password
USER_DB_MIGRATOR_PASSWORD=change-local-user-migrator-password
USER_DB_APP_PASSWORD=change-local-user-app-password
NOTIFICATION_DB_MIGRATOR_PASSWORD=change-local-notification-migrator-password
NOTIFICATION_DB_APP_PASSWORD=change-local-notification-app-password
FINANCE_DB_MIGRATOR_PASSWORD=change-local-finance-migrator-password
FINANCE_DB_APP_PASSWORD=change-local-finance-app-password
PAYMENT_DB_MIGRATOR_PASSWORD=change-local-payment-migrator-password
PAYMENT_DB_APP_PASSWORD=change-local-payment-app-password
KEYCLOAK_DB_USERNAME=vistay
KEYCLOAK_DB_PASSWORD=change-local-postgres-password
REDIS_PASSWORD=change-local-redis-password
MINIO_ROOT_USER=vistay
MINIO_ROOT_PASSWORD=change-local-minio-password
KAFKA_ADMIN_PASSWORD=change-local-kafka-admin-password
KAFKA_AUTHENTICATION_PASSWORD=change-local-kafka-authentication-password
KAFKA_USER_PASSWORD=change-local-kafka-user-password
KAFKA_PROPERTY_PASSWORD=change-local-kafka-property-password
KAFKA_BOOKING_PASSWORD=change-local-kafka-booking-password
KAFKA_FINANCE_PASSWORD=change-local-kafka-finance-password
KAFKA_PAYMENT_PASSWORD=change-local-kafka-payment-password
KAFKA_OPERATIONS_PASSWORD=change-local-kafka-operations-password
KAFKA_OTA_PASSWORD=change-local-kafka-ota-password
KAFKA_NOTIFICATION_PASSWORD=change-local-kafka-notification-password
KAFKA_MEDIA_PASSWORD=change-local-kafka-media-password
KAFKA_WAREHOUSE_PASSWORD=change-local-kafka-warehouse-password
KAFKA_STORE_PASSWORD=change-local-kafka-store-password

# Keycloak bootstrap credentials are used only to create the initial master admin.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=vistay-bootstrap-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=change-local-keycloak-admin-password
KEYCLOAK_ADMIN_CLIENT_SECRET=change-local-keycloak-admin-client-secret
VISTAY_BOOTSTRAP_TOKEN=change-local-bootstrap-token-at-least-32-characters
KEYCLOAK_DB_URL=jdbc:postgresql://postgres:5432/vistay_keycloak_db
KEYCLOAK_PUBLIC_URL=http://identity.localhost

# Backoffice Hive Router OIDC validation and browser origins.
BACKOFFICE_JWKS_URL=http://keycloak:8080/realms/vistay-backoffice/protocol/openid-connect/certs
BACKOFFICE_JWT_ISSUERS=http://identity.localhost/realms/vistay-backoffice
BACKOFFICE_JWT_AUDIENCES=vistay-backoffice-api
BACKOFFICE_CORS_ALLOWED_ORIGINS=http://admin.localhost
HIVE_ROUTER_LOG_LEVEL=info

# Nginx is the sole public ingress. TLS termination is a separate production gate.
EDGE_BIND_ADDRESS=0.0.0.0
EDGE_HTTP_PORT=80
BACKOFFICE_GRAPHQL_HOST=graphql.localhost
KEYCLOAK_HOST=identity.localhost
BACKOFFICE_WEB_HOST=admin.localhost
BACKOFFICE_AUTH_HOST=auth.localhost
OBJECT_STORAGE_HOST=objects.localhost
CHANNEL_MANAGER_WEBHOOK_HOST=channels.localhost
PAYMENT_WEBHOOK_HOST=payments.localhost

# Dependency ports bind to loopback by default and are never public ingress.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
KAFKA_BIND_ADDRESS=127.0.0.1
KAFKA_EXTERNAL_PORT=9093
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
