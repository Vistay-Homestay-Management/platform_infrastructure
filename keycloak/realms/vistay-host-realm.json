{
  "realm": "vistay-host",
  "displayName": "ViStay Host",
  "enabled": false,
  "sslRequired": "external",
  "registrationAllowed": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "roles": {
    "realm": [
      { "name": "HOST_ADMIN", "description": "Host organization administrator" },
      { "name": "HOST_MEMBER", "description": "Host organization member" }
    ]
  },
  "clients": [
    {
      "clientId": "vistay-host-api",
      "name": "ViStay Host API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    },
    {
      "clientId": "vistay-host-web",
      "name": "ViStay Host Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://host.localhost/*"],
      "webOrigins": ["http://host.localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://host.localhost/*"
      },
      "protocolMappers": [
        {
          "name": "host-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vistay-host-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
