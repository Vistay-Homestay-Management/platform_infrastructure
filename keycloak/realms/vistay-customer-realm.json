{
  "realm": "vistay-customer",
  "displayName": "ViStay Customer",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "smtpServer": {
    "host": "${VISTAY_CUSTOMER_SMTP_HOST}",
    "port": "${VISTAY_CUSTOMER_SMTP_PORT}",
    "from": "${VISTAY_CUSTOMER_SMTP_FROM}",
    "auth": "${VISTAY_CUSTOMER_SMTP_AUTH}",
    "starttls": "${VISTAY_CUSTOMER_SMTP_STARTTLS}",
    "ssl": "${VISTAY_CUSTOMER_SMTP_SSL}",
    "user": "${VISTAY_CUSTOMER_SMTP_USER}",
    "password": "${VISTAY_CUSTOMER_SMTP_PASSWORD}"
  },
  "roles": {
    "realm": [
      { "name": "CUSTOMER", "description": "ViStay customer" }
    ]
  },
  "defaultRoles": ["CUSTOMER"],
  "clients": [
    {
      "clientId": "vistay-customer-api",
      "name": "ViStay Customer API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    },
    {
      "clientId": "vistay-customer-web",
      "name": "ViStay Customer Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://customer.localhost/*"],
      "webOrigins": ["http://customer.localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://customer.localhost/*"
      },
      "protocolMappers": [
        {
          "name": "customer-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vistay-customer-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "customer-account-type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "account_type",
            "claim.value": "CUSTOMER",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "vistay-auth-facade",
      "name": "ViStay Auth Facade",
      "description": "Server-side profile lifecycle administration for the Customer realm",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true
    }
  ],
  "users": [
    {
      "username": "service-account-vistay-auth-facade",
      "enabled": true,
      "serviceAccountClientId": "vistay-auth-facade",
      "clientRoles": {
        "realm-management": ["manage-users", "query-users", "view-users"]
      }
    }
  ]
}
