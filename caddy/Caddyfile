{
	admin off
	grace_period 20s
}

(access_log) {
	log {
		output stdout
		format json
	}
}

(security_headers) {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

# This listener is container-internal and is used by the Compose health check.
http://127.0.0.1:8080 {
	respond /healthz "ok" 200
}

{$BACKOFFICE_GRAPHQL_SITE_ADDRESS:http://graphql.localhost} {
	import access_log
	import security_headers

	route {
		@ready path /_edge/ready
		rewrite @ready /readiness

		@router path /graphql /graphql/* /readiness
		reverse_proxy @router router-backoffice:4000 {
			health_uri /readiness
			health_interval 10s
			health_timeout 2s
			flush_interval -1
		}

		respond 404
	}
}

{$KEYCLOAK_SITE_ADDRESS:http://identity.localhost} {
	import access_log
	import security_headers

	route {
		# Only the Backoffice realm and login theme assets are public in Epic 01.
		# Other realms and Keycloak's administrative surface stay internal.
		@identity_public path /realms/vistay-backoffice/* /resources/*
		reverse_proxy @identity_public keycloak:8080

		respond 404
	}
}

{$BACKOFFICE_WEB_SITE_ADDRESS:http://admin.localhost} {
	import access_log
	import security_headers
	reverse_proxy frontend-admin:8080
}

# The bootstrap endpoint is intentionally isolated from the GraphQL surface
# and also enforces its own one-time bootstrap credential and idempotency key.
{$BACKOFFICE_AUTH_SITE_ADDRESS:http://auth.localhost} {
	import access_log
	import security_headers

	route {
		@ready path /_edge/ready
		rewrite @ready /actuator/health/readiness

		@authentication path /api/v1/backoffice/accounts/bootstrap /actuator/health/readiness
		reverse_proxy @authentication authentication:8080

		respond 404
	}
}

# Presigned object requests retain the exact path and query string; MinIO
# validates the signature. Caddy does not make an authorization decision.
{$OBJECT_STORAGE_SITE_ADDRESS:http://objects.localhost} {
	import access_log
	import security_headers
	reverse_proxy minio:9000
}

# Only the Channel Manager webhook surface is reachable on this host.
{$CHANNEL_MANAGER_WEBHOOK_SITE_ADDRESS:http://channels.localhost} {
	import access_log
	import security_headers

	@channel_webhook path /webhooks/channel-manager /webhooks/channel-manager/*
	reverse_proxy @channel_webhook ota:8080
	respond 404
}
